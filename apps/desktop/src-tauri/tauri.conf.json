{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diandianreading",
  "version": "0.1.0",
  "identifier": "com.diandianreading.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "resources/sidecar": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": false
  }
}
